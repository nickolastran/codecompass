# Copy this file into .env before running the Backend

# Supabase (same project as the frontend)
SUPABASE_URL=
SUPABASE_KEY=

# GitHub App (same app as the frontend)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# Embeddings / LLM providers
VOYAGE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DOCUMENT_EMBEDDING_MODEL=

# Other Choices
OLLAMA_AGENT_MODEL="qwen2.5:3b"
